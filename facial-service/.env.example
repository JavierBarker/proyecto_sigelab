# SQL Server: same database used by universidadAsistencia
DB_HOST=127.0.0.1
DB_PORT=14330
DB_NAME=SIGELAB
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Generate with: python -m scripts.generate_key
# Keep this value stable after enrollment; changing it makes stored embeddings unreadable.
FACIAL_ENCRYPTION_KEY=CHANGE_ME

FACIAL_HOST=127.0.0.1
FACIAL_PORT=8765
# Leave blank for automatic selection. Set an integer to force a camera.
CAMERA_INDEX=
CAMERA_NAME_HINT=
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
SHOW_PREVIEW=true
FACIAL_DEBUG=false

FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.55
FACE_MIN_SIZE=120
BLUR_THRESHOLD=80
BRIGHTNESS_MIN=45
BRIGHTNESS_MAX=220
MAX_YAW=28
MAX_PITCH=22
ENROLL_SAMPLE_COUNT=20
VERIFY_SAMPLE_COUNT=7
ENROLL_TIMEOUT_SECONDS=100
VERIFY_TIMEOUT_SECONDS=20
LIVENESS_TIMEOUT_SECONDS=15
SAMPLE_INTERVAL_SECONDS=0.15

# auto selects available acceleration and always falls back to CPUExecutionProvider.
ONNX_PROVIDERS=auto

FACIAL_API_TOKEN=GENERAR_CON_CONFIGURAR
